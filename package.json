{
  "name": "typst-collab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "stress:build": "node stress/build.mjs",
    "stress": "npm run stress:build && node stress/dist/headless.mjs",
    "stress:scripted": "npm run stress:build && node stress/dist/headless.mjs --phase=scripted",
    "stress:chaos": "npm run stress:build && node stress/dist/headless.mjs --phase=chaos"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18",
    "@codemirror/commands": "^6.7",
    "@codemirror/lang-xml": "^6.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.10",
    "@codemirror/state": "^6.4",
    "@codemirror/view": "^6.34",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@vedivad/codemirror-typst": "0.18.6",
    "@vedivad/typst-web-service": "^0.18.0",
    "@vueuse/core": "^12.0",
    "codemirror": "^6.0",
    "js-yaml": "^4.1",
    "vue": "^3.5",
    "y-codemirror.next": "^0.3",
    "y-indexeddb": "^9.0",
    "y-websocket": "^2.0",
    "yjs": "^13.6",
    "yjs-boxtools": "github:twitwi/yjs-boxtools"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2",
    "typescript": "~5.7",
    "vite": "^6.0",
    "vue-tsc": "^2.2",
    "ws": "^8.18"
  }
}
