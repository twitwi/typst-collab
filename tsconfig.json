{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "yjs": ["./node_modules/yjs"],
      "y-websocket": ["./node_modules/y-websocket"],
      "y-indexeddb": ["./node_modules/y-indexeddb"],
      "vue": ["./node_modules/vue"],
      "@vueuse/core": ["./node_modules/@vueuse/core"],
      "js-yaml": ["./node_modules/js-yaml"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "../yjs-datatools/*.ts"]
}
